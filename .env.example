# CrowdWisdomTrading X Sentiment Price Prediction Agent
# Configuration & API Credentials

# 1. Apify API Token (https://apify.com/)
# Actor: apidojo/tweet-scraper (Actor ID: 61RPP7dywgiy0JPD0) or apify/twitter-scraper
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_TWEET_ACTOR_ID=61RPP7dywgiy0JPD0

# 2. Tavily / Exa News API (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# 3. Target Asset Configuration
TICKER=NVDA
COMPANY_NAME="NVIDIA Corporation"
KEYWORDS="$NVDA,NVDA,NVIDIA,Blackwell,Jensen Huang"
LOOKBACK_DAYS=180

# 4. Pipeline Execution Mode
# Options: 'live' (requires valid API keys), 'offline' (deterministic high-fidelity backtest generator), 'auto' (checks keys, falls back gracefully)
PIPELINE_MODE=auto

# 5. Database Path
DATABASE_PATH=data/crowdwisdom.db
